# 1. KẾT NỐI MÁY CHỦ REST API (DO SV 4 TRIỂN KHAI)
# - Môi trường phát triển cục bộ: http://localhost:5000
# - Môi trường staging/production: https://api.nitrohotel.vn
# - LƯU Ý: Nếu để trống, Frontend sẽ tự động kích hoạt Dual-Mode Fallback sang Mock Data 4 sao (src/mocks/data.ts)
VITE_API_URL=http://localhost:5000

# 2. CƠ CHẾ DUAL-MODE DỮ LIỆU
# - true: Chạy dữ liệu giả lập chuẩn 4 sao độc lập (phục vụ bảo vệ đồ án ngoại tuyến)
# - false: Kết nối trực tiếp máy chủ Backend REST API của SV 4
VITE_USE_MOCK=false

# 3. THÔNG TIN THƯƠNG HIỆU & KHÁCH SẠN
VITE_HOTEL_NAME="Nitro Grand Hotel"
VITE_HOTEL_HOTLINE="1900 6868"
VITE_HOTEL_ADDRESS="24 Nguyễn Huệ, Phường Bến Nghé, Quận 1, TP. Hồ Chí Minh"
