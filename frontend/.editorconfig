# ============================================================================
# EditorConfig - Quy chuẩn soạn thảo mã nguồn dự án Nitro Hotel
# Phục vụ đồng bộ quy chuẩn code giữa các thành viên (TASK-06)
# ============================================================================
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false
